# RCON connection (must match server.properties on the Minecraft server)
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=

# Absolute path to the WorldEdit craftscripts folder on the Minecraft server
CRAFTSCRIPTS_DIR=C:\path\to\your\server\config\worldedit\craftscripts

# Absolute path to the server's live log file, used as a fallback output channel
# when WorldEdit feedback isn't captured in the RCON response itself.
SERVER_LOG_PATH=C:\path\to\your\server\logs\latest.log

# Absolute path to the server's ops.json — usernames listed here get admin access
# (craftscript file management, acting as any player) once verified.
OPS_FILE=C:\path\to\your\server\ops.json

# Where self-issued device tokens are persisted (created by verify_login_code, or by the
# OAuth token endpoint). Defaults to ./devices.json next to this project if unset. Never
# commit this file.
DEVICES_FILE=./devices.json

# Where dynamically registered OAuth clients are persisted (created by MCP clients that do
# an OAuth handshake before calling /mcp, e.g. Claude Desktop's Connectors). Defaults to
# ./oauth-clients.json if unset. Never commit this file.
OAUTH_CLIENTS_FILE=./oauth-clients.json

# Timeouts (milliseconds)
RCON_TIMEOUT_MS=5000
LOG_TAIL_TIMEOUT_MS=3000

# weditmcpbridge companion mod connection (required — see ../worldedit-mcp-bridge-mod).
# run_craftscript / get_selection_info / undo go through this, not RCON, since RCON cannot
# make WorldEdit recognize a command as coming from a specific player.
WEDIT_BRIDGE_HOST=127.0.0.1
WEDIT_BRIDGE_PORT=25577
WEDIT_BRIDGE_TIMEOUT_MS=10000

# HTTP transport — 0.0.0.0 to accept connections from other devices (via port
# forwarding / your router), 127.0.0.1 to restrict to this machine only.
# Use port 443 if you want Claude Desktop's Connectors to work — it only connects to
# standard HTTPS port 443, confirmed empirically (any other port silently never connects).
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=443

# TLS (optional but required by some MCP clients, e.g. Claude Desktop's custom
# connector, which only accepts https:// URLs even for localhost). Generate a
# locally-trusted cert with mkcert (https://github.com/FiloSottile/mkcert):
#   mkcert -install   (one-time, adds a local CA to your OS trust store)
#   mkcert -cert-file certs/localhost-cert.pem -key-file certs/localhost-key.pem 127.0.0.1 localhost
# Leave both unset to serve plain HTTP instead.
TLS_CERT_FILE=./certs/localhost-cert.pem
TLS_KEY_FILE=./certs/localhost-key.pem
