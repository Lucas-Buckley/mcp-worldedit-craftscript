# RCON connection (must match server.properties on the Minecraft server)
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=

# Absolute path to the WorldEdit craftscripts folder on the Minecraft server
CRAFTSCRIPTS_DIR=C:\path\to\your\server\config\worldedit\craftscripts

# Absolute path to the server's live log file, used as a fallback output channel
# when WorldEdit feedback isn't captured in the RCON response itself.
SERVER_LOG_PATH=C:\path\to\your\server\logs\latest.log

# Timeouts (milliseconds)
RCON_TIMEOUT_MS=5000
LOG_TAIL_TIMEOUT_MS=3000
